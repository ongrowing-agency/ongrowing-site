---
import IconSprite from '../components/IconSprite.astro';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/raleway/400.css';
import '@fontsource/raleway/700.css';
import '@fontsource/raleway/800.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  noFooter?: boolean;
}

const {
  title,
  description = 'A Ongrowing monta e opera a arquitetura completa de aquisição do seu e-commerce — diagnóstico, tráfego pago, automações e IA trabalhando juntos.',
  ogImage = '/assets/mark-dark.png',
  noindex = false,
  noFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-TXGCXH9N');
</script>
<!-- End Google Tag Manager -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex,nofollow">}
  <link rel="canonical" href={canonicalURL}>
  <link rel="icon" type="image/png" href="/assets/mark-dark.png">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="Ongrowing">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Global CSS -->
  <link rel="stylesheet" href="/styles/site.css">

  <slot name="head" />
</head>
<body>
<!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TXGCXH9N"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
  <IconSprite />

  <!-- NAV OVERLAY -->
  <div class="nav-overlay" data-nav-close aria-hidden="true"></div>

  <SiteNav currentPath={Astro.url.pathname} />

  <main class="main">
    <slot />

    {!noFooter && <Footer />}
  </main>

  <WhatsAppButton />

  <!-- Shared JS -->
  <script is:inline src="/scripts/site.js"></script>
  <slot name="scripts" />
</body>
</html>
