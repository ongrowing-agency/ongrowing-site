---
const ideal = [
  'Fatura $80k+ por mês e quer escalar com estrutura, não com sorte',
  'Já tem produto validado e operação rodando. Falta a arquitetura de aquisição',
  'Quem decide senta na mesa: o sócio majoritário toca a conversa',
  'Tem budget de mídia real, a partir de $3k/mês. Sem isso não há o que otimizar',
  'Participa do jogo: aprova criativo, entrega dado, executa o combinado',
];
const fora = [
  'Quer pacote fechado e resultado garantido antes de qualquer diagnóstico',
  'Pensa em terceirizar 100% e sumir. Marketing não funciona assim',
  'Não tem budget de mídia e quer crescer sem investir',
  'Culpa a agência quando o número não vem',
  'Some na hora de aprovar, responder ou executar',
];
---
<section id="para-quem">
  <div class="section-header reveal">
    <span class="section-num">03 · Para quem é</span>
    <div class="section-title-group">
      <h2>A Ongrowing não é para todo mundo.</h2>
      <p class="lead">E isso é intencional. Trabalhamos melhor com quem busca clareza — não com quem caça atalho.</p>
    </div>
  </div>
  <div class="pq-grid reveal">
    <article class="pq-card pq-good">
      <header class="pq-card-head">
        <div class="pq-icon-badge">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h3 class="pq-tag">Perfil ideal</h3>
      </header>
      <ul class="pq-list">
        {ideal.map((item) => (
          <li class="pq-item">
            <span class="pq-item-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>

    <article class="pq-card pq-bad">
      <header class="pq-card-head">
        <div class="pq-icon-badge">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </div>
        <h3 class="pq-tag">Fora do perfil</h3>
      </header>
      <ul class="pq-list">
        {fora.map((item) => (
          <li class="pq-item">
            <span class="pq-item-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>
