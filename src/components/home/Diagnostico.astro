---
// src/components/home/Diagnostico.astro
---

<section id="diagnostico">
  <div class="diag-wrap">

    <!-- ── CABEÇALHO: sempre primeiro, fora do grid ── -->
    <div class="diag-head reveal">
      <p class="section-num">06 · Diagnóstico</p>
      <h2>Descubra onde está o <em>gargalo</em> da sua operação</h2>
      <p class="lead">5 minutos. 9 perguntas. Receba um diagnóstico da sua operação com uma quick win pra aplicar essa semana, sem spam, sem call obrigatória.</p>
    </div>

    <!-- ── GRID: promises esquerda, form direita ── -->
    <div class="diag-grid">

      <!-- ESQUERDA: benefits 2×2 -->
      <div class="diag-promises reveal">
        <div class="promise-item">
          <div class="promise-icon">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
          </div>
          <div class="promise-text">
            <h4>Análise real, não relatório genérico</h4>
            <p>Cada resposta molda o diagnóstico. Uma leitura específica do seu negócio, não um PDF padrão.</p>
          </div>
        </div>
        <div class="promise-item">
          <div class="promise-icon">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <div class="promise-text">
            <h4>Uma dica pra aplicar essa semana</h4>
            <p>Sem teoria. O e-mail já vem com uma ação concreta baseada no seu maior gargalo identificado.</p>
          </div>
        </div>
        <div class="promise-item">
          <div class="promise-icon">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="promise-text">
            <h4>Sem compromisso, sem ligação</h4>
            <p>Nenhuma reunião obrigatória. Nenhuma proposta empurrada. Só o diagnóstico.</p>
          </div>
        </div>
        <div class="promise-item">
          <div class="promise-icon">
            <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </div>
          <div class="promise-text">
            <h4>Quanto mais contexto, melhor</h4>
            <p>Com o link da sua loja ou Instagram o diagnóstico fica ainda mais específico.</p>
          </div>
        </div>
      </div>

      <!-- DIREITA: formulário -->
      <div class="diag-right reveal">
        <div class="diag-form-card">

          <!-- Progress: embutido no topo do card -->
          <div class="pd-ctr" id="pd-ctr" style="display:none">
            <div class="pd-ctr-row">
              <span class="pd-step-lbl" id="pd-step-lbl">Etapa 1 de 9</span>
              <span class="pd-pct" id="pd-pct">0%</span>
            </div>
            <div class="pd-dots" id="pd-dots"></div>
            <div class="pd-motiv" id="pd-motiv" style="display:none"></div>
          </div>

          <!-- Body do formulário -->
          <div id="pd-body"></div>

        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
/* ── DIAGNOSTICO ── */
#diagnostico {
  background: var(--og-deep-800);
  overflow: hidden;
  border-bottom: none;
  position: relative;
}
#diagnostico::before {
  content: '';
  position: absolute;
  top: -120px; right: -120px;
  width: 720px; height: 720px;
  background: radial-gradient(circle, rgba(121,217,199,.06) 0%, transparent 62%);
  pointer-events: none;
}

/* ── WRAPPER ── */
.diag-wrap {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0 var(--sp-6);
  display: flex;
  flex-direction: column;
  gap: clamp(40px, 6vw, 72px);
  position: relative;
}

/* ── CABEÇALHO ── */
.diag-head { max-width: 720px; }

#diagnostico .section-num {
  color: rgba(121,217,199,.6);
  font-family: var(--font-display);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 3.5px;
  margin-bottom: var(--sp-4);
  display: inline-flex;
  align-items: center;
  gap: var(--sp-3);
}
#diagnostico .section-num::before {
  content: '';
  display: inline-block;
  width: 22px;
  height: 1px;
  background: rgba(121,217,199,.6);
  opacity: .7;
}

/* ── TÍTULOS ── */
#diagnostico h2 {
  font-family: var(--font-display);
  font-size: clamp(28px, 4vw, 48px);
  font-weight: 800;
  color: #fff;
  line-height: 1.08;
  letter-spacing: -1.4px;
  margin-bottom: var(--sp-4);
  text-wrap: balance;
}
#diagnostico h2 em { font-style: italic; color: var(--accent); font-weight: 800; }
#diagnostico .lead {
  font-family: var(--font-text);
  font-size: clamp(15px, 1.8vw, 18px);
  color: rgba(255,255,255,.55);
  line-height: 1.65;
  font-weight: 300;
}

/* ── GRID DUAS COLUNAS ── */
.diag-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: start;
}

/* ── PROMISES: grade 2×2 ── */
.diag-promises {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
.promise-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16px;
  padding: 28px;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: var(--r-md);
  transition: border-color var(--dur-fast) var(--ease-out),
              background    var(--dur-fast) var(--ease-out);
}
.promise-item:hover {
  border-color: rgba(121,217,199,.22);
  background: rgba(121,217,199,.05);
}
.promise-icon {
  width: 40px; height: 40px;
  border-radius: var(--r-sm);
  background: rgba(121,217,199,.1);
  border: 1px solid rgba(121,217,199,.18);
  color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.promise-icon .icon { width: 20px; height: 20px; }
.promise-text h4 {
  font-family: var(--font-display);
  font-size: 14.5px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6px;
  letter-spacing: -.1px;
  line-height: 1.3;
}
.promise-text p {
  font-family: var(--font-text);
  font-size: 13px;
  color: rgba(255,255,255,.5);
  line-height: 1.65;
}

/* ── COLUNA DIREITA ── */
.diag-right {
  position: sticky;
  top: 24px;
}

/* Card unificado: progress + form */
.diag-form-card {
  background: rgba(255,255,255,.035);
  border: 1px solid rgba(255,255,255,.09);
  border-radius: var(--r-lg);
  overflow: hidden;
}

/* ── PROGRESS COUNTER ── */
.pd-ctr {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: rgba(0,0,0,.12);
}
.pd-ctr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}
.pd-step-lbl {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,.6);
}
.pd-pct {
  font-family: var(--font-display);
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
}
.pd-dots { display: flex; align-items: center; gap: 4px; }
.pd-d { height: 4px; border-radius: 3px; flex-shrink: 0; transition: all .35s ease; }
.pd-d.done { width: 4px;  background: rgba(121,217,199,.4); }
.pd-d.cur  { width: 20px; background: var(--accent); }
.pd-d.next { width: 4px;  background: rgba(255,255,255,.12); }
.pd-motiv {
  margin-top: 8px;
  font-family: var(--font-display);
  font-size: 11px;
  font-weight: 700;
  color: var(--accent);
  letter-spacing: .03em;
  display: flex;
  align-items: center;
  gap: 5px;
}

/* ── QUESTION CARD ── */
/* Override explícito: anula qualquer background/border vindo do CSS global */
.pd-card {
  padding: 20px 20px 0;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  border-radius: 0 !important;
  margin-bottom: 0 !important;
  animation: pdIn .22s ease;
}
@keyframes pdIn {
  from { opacity: 0; transform: translateX(8px); }
  to   { opacity: 1; transform: translateX(0); }
}
.pd-q {
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 600;
  color: #fff;
  line-height: 1.45;
  margin-bottom: 1rem;
  letter-spacing: -.1px;
}
.pd-opts { display: flex; flex-direction: column; gap: 8px; }
.pd-opt {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: var(--r-md);
  cursor: pointer;
  background: rgba(255,255,255,.02);
  user-select: none;
  transition: border-color .15s, background .15s;
}
.pd-opt:hover { border-color: rgba(121,217,199,.4); background: rgba(255,255,255,.05); }
.pd-opt.sel   { border-color: var(--accent); background: rgba(121,217,199,.07); }
.pd-radio {
  width: 17px; height: 17px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,.3);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: all .14s;
}
.pd-opt.sel .pd-radio { background: var(--accent); border-color: var(--accent); }
.pd-rdot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--og-deep-800);
  opacity: 0;
  transition: opacity .14s;
}
.pd-opt.sel .pd-rdot { opacity: 1; }
.pd-opt-txt {
  font-family: var(--font-text);
  font-size: 13.5px;
  color: rgba(255,255,255,.75);
  line-height: 1.4;
}
.pd-opt.sel .pd-opt-txt { color: #fff; }

/* ── NAV ── */
.pd-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px 20px;
}
.pd-back {
  font-family: var(--font-display);
  font-size: 12.5px;
  color: rgba(255,255,255,.35);
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px 0;
  transition: color .14s;
}
.pd-back:hover { color: rgba(255,255,255,.75); }
.pd-hint {
  font-family: var(--font-text);
  font-size: 11.5px;
  color: rgba(255,255,255,.22);
}

/* ── LINK STEP ── */
.pd-link-desc {
  font-family: var(--font-text);
  font-size: 13.5px;
  color: rgba(255,255,255,.5);
  line-height: 1.65;
  margin-bottom: 1rem;
}
.pd-link-inp {
  width: 100%;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: var(--r-md);
  padding: 13px 16px;
  font-family: var(--font-text);
  font-size: 14px;
  color: #fff;
  outline: none;
  transition: border-color .15s, background .15s;
  margin-bottom: 12px;
}
.pd-link-inp::placeholder { color: rgba(255,255,255,.28); }
.pd-link-inp:focus { border-color: rgba(121,217,199,.5); background: rgba(255,255,255,.06); }
.pd-link-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pd-link-skip {
  font-family: var(--font-display);
  font-size: 12px;
  color: rgba(255,255,255,.3);
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px 0;
  transition: color .14s;
}
.pd-link-skip:hover { color: rgba(255,255,255,.6); }
.pd-link-next {
  padding: 11px 20px;
  background: var(--accent);
  color: var(--og-deep-800);
  border: none;
  border-radius: var(--r-md);
  font-family: var(--font-display);
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity .15s;
}
.pd-link-next:hover { opacity: .82; }

/* ── CONTACT STEP ── */
.pd-contact-tag {
  font-family: var(--font-display);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2.5px;
  color: var(--accent);
  margin-bottom: 8px;
}
.pd-contact-desc {
  font-family: var(--font-text);
  font-size: 13.5px;
  color: rgba(255,255,255,.5);
  line-height: 1.65;
  margin-bottom: 1.25rem;
}
.pd-field { margin-bottom: 10px; }
.pd-lbl {
  display: block;
  font-family: var(--font-display);
  font-size: 11px;
  font-weight: 600;
  color: rgba(255,255,255,.45);
  margin-bottom: 5px;
  letter-spacing: .03em;
}
.diag-input {
  width: 100%;
  background: rgba(255,255,255,.04);
  border: 1px solid rgba(255,255,255,.1);
  border-radius: var(--r-md);
  padding: 13px 16px;
  font-family: var(--font-text);
  font-size: 14px;
  color: #fff;
  outline: none;
  transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
}
.diag-input::placeholder { color: rgba(255,255,255,.28); }
.diag-input:focus { border-color: rgba(121,217,199,.5); background: rgba(255,255,255,.06); box-shadow: none; }
.diag-btn {
  padding: 13px 22px;
  background: var(--accent);
  color: var(--og-deep-800);
  border: none;
  border-radius: var(--r-md);
  font-family: var(--font-display);
  font-size: 13.5px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: .02em;
  transition: opacity .15s;
}
.diag-btn:disabled { opacity: .3; cursor: not-allowed; }
.diag-btn:not(:disabled):hover { opacity: .82; }

/* ── SUCCESS ── */
.pd-ok {
  text-align: center;
  padding: 2.5rem 1.25rem;
  animation: pdIn .3s ease;
}
.pd-ok-icon {
  width: 52px; height: 52px;
  border-radius: 50%;
  background: rgba(121,217,199,.1);
  border: 1px solid rgba(121,217,199,.28);
  color: var(--accent);
  font-size: 20px;
  font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 1.25rem;
}
.pd-ok-title {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 700;
  color: #fff;
  margin-bottom: .6rem;
  letter-spacing: -.2px;
}
.pd-ok-desc {
  font-family: var(--font-text);
  font-size: 13.5px;
  color: rgba(255,255,255,.5);
  line-height: 1.65;
  max-width: 320px;
  margin: 0 auto;
}

/* ── RESPONSIVE ── */
@media (max-width: 960px) {
  .diag-wrap { gap: var(--sp-8); padding: 0 var(--sp-5); }
  .diag-grid {
    grid-template-columns: 1fr;
    gap: var(--sp-7);
  }
  .diag-right { position: static; }
  /* Form vem antes dos promises no mobile, mas SEMPRE depois do cabeçalho */
  .diag-right    { order: 1; }
  .diag-promises { order: 2; }
}
@media (max-width: 560px) {
  .diag-wrap     { gap: var(--sp-7); }
  .diag-promises { grid-template-columns: 1fr; gap: 10px; }
  .promise-item  { padding: 22px; gap: 14px; }
}
</style>

<script>
  const QS = [
    { id: 'fat', text: 'Qual é o faturamento mensal atual do seu e-commerce?', opts: [
      { v: 'a', l: 'Menos de R$50k/mês' },
      { v: 'b', l: 'R$50k – R$200k/mês' },
      { v: 'c', l: 'R$200k – R$500k/mês' },
      { v: 'd', l: 'Acima de R$500k/mês' }
    ]},
    { id: 'can', text: 'Como você atrai novos clientes hoje?', opts: [
      { v: 'a', l: 'Só canais orgânicos (redes sociais ou SEO)' },
      { v: 'b', l: 'Meta Ads (Facebook / Instagram)' },
      { v: 'c', l: 'Google Ads (pesquisa ou shopping)' },
      { v: 'd', l: 'Meta + Google ativos ao mesmo tempo' }
    ]},
    { id: 'inv', text: 'Quanto você investe em mídia paga por mês?', opts: [
      { v: 'a', l: 'Não invisto em mídia paga' },
      { v: 'b', l: 'Até R$5k/mês' },
      { v: 'c', l: 'R$5k – R$20k/mês' },
      { v: 'd', l: 'Acima de R$20k/mês' }
    ]},
    { id: 'nut', text: 'Você se comunica ativamente com seus leads e clientes?', opts: [
      { v: 'a', l: 'Não — só quando eles me procuram' },
      { v: 'b', l: 'Mando e-mails ou mensagens avulsas às vezes' },
      { v: 'c', l: 'Tenho automações de e-mail ou WhatsApp ativas' },
      { v: 'd', l: 'Uso retargeting para reimpactar quem visitou o site' }
    ]},
    { id: 'carr', text: 'Como você lida com quem visitou seu site e não comprou?', opts: [
      { v: 'a', l: 'Não faço nada — perdi essa venda' },
      { v: 'b', l: 'Mando lembrete manual às vezes' },
      { v: 'c', l: 'Tenho automação de recuperação (e-mail ou WhatsApp)' },
      { v: 'd', l: 'Uso retargeting + automação juntos' }
    ]},
    { id: 'conv', text: 'Você monitora e tenta melhorar a taxa de conversão do seu site?', opts: [
      { v: 'a', l: 'Não — nunca trabalhei nisso' },
      { v: 'b', l: 'Olho os números, mas não faço mudanças' },
      { v: 'c', l: 'Faço ajustes com frequência, com base nos dados' },
      { v: 'd', l: 'Tenho processo ativo de testes e otimização' }
    ]},
    { id: 'rec', text: 'Como você trabalha a base de clientes que já comprou?', opts: [
      { v: 'a', l: 'Não tenho estratégia de pós-venda' },
      { v: 'b', l: 'Mando promoções pontuais às vezes' },
      { v: 'c', l: 'Tenho fluxo de pós-venda ativo (e-mail ou WhatsApp)' },
      { v: 'd', l: 'Tenho programa de fidelidade ou recorrência' }
    ]},
    { id: 'gar', text: 'Onde você sente que está travando o crescimento do seu negócio?', opts: [
      { v: 'a', l: 'Não consigo trazer visitantes qualificados' },
      { v: 'b', l: 'Os visitantes chegam mas não compram' },
      { v: 'c', l: 'Os clientes compram uma vez e somem' },
      { v: 'd', l: 'Não sei identificar onde está o problema' }
    ]}
  ];

  const MOTIVS: Record<number, string> = {
    3: 'Você está na metade — vamos lá!',
    5: 'Mais da metade, continue!',
    6: 'Quase terminando!',
    7: 'Falta só mais uma!',
    8: 'Última pergunta!'
  };

  const N = QS.length;
  const TOTAL_STEPS = N + 1; // 8 perguntas + 1 link = 9 etapas
  let step = 0;
  const ans: Record<string, string> = {};
  let going = false;

  function buildDots(s: number): string {
    return Array.from({ length: TOTAL_STEPS }, (_, i) => {
      const c = i < s ? 'done' : i === s ? 'cur' : 'next';
      return `<div class="pd-d ${c}"></div>`;
    }).join('');
  }

  function updateCtr(s: number): void {
    const ctr = document.getElementById('pd-ctr')!;
    if (s >= TOTAL_STEPS) { ctr.style.display = 'none'; return; }
    ctr.style.display = 'block';
    document.getElementById('pd-step-lbl')!.textContent = `Etapa ${s + 1} de 9`;
    document.getElementById('pd-pct')!.textContent = Math.round((s / TOTAL_STEPS) * 100) + '%';
    document.getElementById('pd-dots')!.innerHTML = buildDots(s);
    const motiv = document.getElementById('pd-motiv')!;
    if (MOTIVS[s]) { motiv.style.display = 'flex'; motiv.textContent = MOTIVS[s]; }
    else { motiv.style.display = 'none'; }
  }

  function render(): void {
    const body = document.getElementById('pd-body')!;
    updateCtr(step);

    if (step < N) {
      const q = QS[step];
      const sel = ans[q.id];
      body.innerHTML = `
        <div class="pd-card">
          <div class="pd-q">${q.text}</div>
          <div class="pd-opts">
            ${q.opts.map(o => `
              <div class="pd-opt${sel === o.v ? ' sel' : ''}" data-v="${o.v}" data-qid="${q.id}">
                <div class="pd-radio"><div class="pd-rdot"></div></div>
                <div class="pd-opt-txt">${o.l}</div>
              </div>`).join('')}
          </div>
        </div>
        <div class="pd-nav">
          <button class="pd-back" id="pd-back" ${step === 0 ? 'style="visibility:hidden"' : ''}>← Voltar</button>
          <span class="pd-hint">Selecione para avançar</span>
        </div>`;

      document.querySelectorAll('.pd-opt').forEach(el => {
        el.addEventListener('click', () => {
          const t = el as HTMLElement;
          pick(t.dataset.qid!, t.dataset.v!);
        });
      });
      document.getElementById('pd-back')?.addEventListener('click', back);

    } else if (step === N) {
      body.innerHTML = `
        <div class="pd-card">
          <div class="pd-q">Quer um diagnóstico ainda mais preciso? <span style="color:rgba(255,255,255,.4);font-weight:400">(opcional)</span></div>
          <p class="pd-link-desc">Cole o link da sua loja ou perfil no Instagram. Com ele, conseguimos analisar detalhes reais da sua operação — pixel, velocidade, captura de leads, vitrine.</p>
          <input id="pd-link" class="pd-link-inp" type="url" placeholder="https://sualojaouinstagram.com">
          <div class="pd-link-actions">
            <button class="pd-link-skip" id="pd-link-skip">Pular esta etapa →</button>
            <button class="pd-link-next" id="pd-link-next">Continuar →</button>
          </div>
        </div>
        <div class="pd-nav">
          <button class="pd-back" id="pd-back">← Voltar</button>
          <span class="pd-hint"></span>
        </div>`;

      document.getElementById('pd-link-next')?.addEventListener('click', () => {
        ans['link'] = (document.getElementById('pd-link') as HTMLInputElement).value.trim();
        step++; render();
      });
      document.getElementById('pd-link-skip')?.addEventListener('click', () => {
        ans['link'] = '';
        step++; render();
      });
      document.getElementById('pd-back')?.addEventListener('click', back);

    } else if (step === TOTAL_STEPS) {
      body.innerHTML = `
        <div class="pd-card">
          <p class="pd-contact-tag">Último passo</p>
          <div class="pd-q">Para onde enviamos a sua análise?</div>
          <p class="pd-contact-desc">Com base nas suas respostas, você vai receber um diagnóstico personalizado e uma quick win pra aplicar ainda essa semana.</p>
          <div class="pd-field">
            <label class="pd-lbl">Seu nome</label>
            <input id="pd-nm" class="diag-input" type="text" placeholder="Como prefere ser chamado?">
          </div>
          <div class="pd-field">
            <label class="pd-lbl">Seu melhor e-mail</label>
            <input id="pd-em" class="diag-input" type="email" placeholder="nome@empresa.com">
          </div>
        </div>
        <div class="pd-nav">
          <button class="pd-back" id="pd-back">← Voltar</button>
          <button class="diag-btn" id="pd-sub" disabled>Quero meu diagnóstico →</button>
        </div>`;

      const nm  = document.getElementById('pd-nm') as HTMLInputElement;
      const em  = document.getElementById('pd-em') as HTMLInputElement;
      const sub = document.getElementById('pd-sub') as HTMLButtonElement;
      const chk = () => {
        sub.disabled = !(nm.value.trim() && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(em.value.trim()));
      };
      nm.addEventListener('input', chk);
      em.addEventListener('input', chk);
      sub.addEventListener('click', submitForm);
      document.getElementById('pd-back')?.addEventListener('click', back);

    } else {
      const fn = (ans['name'] || '').split(' ')[0];
      body.innerHTML = `
        <div class="pd-ok">
          <div class="pd-ok-icon">✓</div>
          <div class="pd-ok-title">Análise a caminho${fn ? ', ' + fn : ''}!</div>
          <p class="pd-ok-desc">Verifique sua caixa de entrada em alguns minutos. Você vai receber um diagnóstico personalizado com uma quick win pra aplicar essa semana.</p>
        </div>`;
    }
  }

  function pick(id: string, v: string): void {
    if (going) return;
    ans[id] = v;
    document.querySelectorAll('.pd-opt').forEach(el =>
      el.classList.toggle('sel', (el as HTMLElement).dataset.v === v)
    );
    going = true;
    setTimeout(() => { step++; going = false; render(); }, 400);
  }

  function back(): void {
    if (step > 0) { step--; render(); }
  }

  async function submitForm(): Promise<void> {
    ans['name']  = (document.getElementById('pd-nm') as HTMLInputElement).value.trim();
    ans['email'] = (document.getElementById('pd-em') as HTMLInputElement).value.trim();
    step++;
    render();
    try {
      const webhook = import.meta.env.PUBLIC_N8N_DIAG_WEBHOOK;
      if (webhook && webhook !== 'https://placeholder.com/webhook') {
        await fetch(webhook, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(ans)
        });
      }
    } catch (e) {
      console.error('Webhook error:', e);
    }
  }

  render();
</script>
