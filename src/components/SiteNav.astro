---
export interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

function isActive(path: string) {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
}
---
<nav class="nav" aria-label="Navegação principal">
  <button class="nav-close" data-nav-close aria-label="Fechar menu">
    <svg class="icon"><use href="#i-x"/></svg>
  </button>
  <div class="nav-logo">
    <a href="/" aria-label="Ongrowing">
      <img src="/assets/logo-horizontal-dark-cropped.png" alt="Ongrowing">
    </a>
  </div>
  <p class="nav-section-label">Site</p>
  <ul>
    <li><a href="/#hero" class={isActive('/') ? 'active' : ''}><span class="num">01</span> Início</a></li>
    <li><a href="/#quem-somos"><span class="num">02</span> Quem somos</a></li>
    <li><a href="/#para-quem"><span class="num">03</span> Para quem é</a></li>
    <li><a href="/#servicos"><span class="num">04</span> O que entregamos</a></li>
    <li><a href="/#cases"><span class="num">05</span> Cases</a></li>
    <li><a href="/#newsletter"><span class="num">06</span> Newsletter</a></li>
  </ul>
  <div class="nav-divider"></div>
  <p class="nav-section-label">Conteúdo</p>
  <ul>
    <li>
      <a href="/cursos/" class={isActive('/cursos') ? 'active' : ''}>
        <svg class="icon"><use href="#i-book"/></svg> Cursos
      </a>
    </li>
    <li>
      <a href="/blog/" class={isActive('/blog') ? 'active' : ''}>
        <svg class="icon"><use href="#i-pen"/></svg> Blog
      </a>
    </li>
  </ul>
  <div class="nav-footer">ongrowing.agency<br>© <span class="year"></span> Ongrowing</div>
</nav>
