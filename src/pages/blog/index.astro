---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import { getPosts } from '../../lib/sanity';

const page = Number(Astro.url.searchParams.get('p') || 1);
const pageSize = 8;

let posts: any[] = [];
let total = 0;
try {
  posts = await getPosts(page, pageSize);
  total = posts.length; // simplified; real total would need a count query
} catch {
  // use static fallback
}

const staticPosts = [
  { slug: { current: 'roas-medio-mente' }, title: 'O ROAS médio mente. O que olhar antes de mudar uma campanha.', excerpt: 'A média esconde o que realmente está acontecendo dentro de uma conta de tráfego. Como ler os dados por janela, canal e funil — e por que isso muda completamente as decisões de otimização.', category: 'Diagnóstico & dados', publishedAt: '2026-05-12', readTime: 8, variant: 1, featured: true },
  { slug: { current: 'topo-de-funil-nao-e-desperdicio' }, title: 'Quando topo de funil deixa de ser desperdício', excerpt: 'Não é a métrica de awareness que justifica o investimento. É o que ele faz com o retargeting da semana seguinte — e a maioria não está medindo isso.', category: 'Tráfego pago', publishedAt: '2026-05-06', readTime: 6, variant: 1 },
  { slug: { current: 'agente-ia-no-atendimento' }, title: 'Agente IA no atendimento: quando ajuda e quando atrapalha', excerpt: 'A IA não substitui equipe de vendas — qualifica, encurta caminho e libera tempo humano para o que vale. Onde colocar e onde tirar da frente do cliente.', category: 'Automação & IA', publishedAt: '2026-05-02', readTime: 7, variant: 2 },
  { slug: { current: 'fluxo-boas-vindas' }, title: 'O fluxo de boas-vindas que paga a aquisição inteira', excerpt: 'Quatro e-mails, sete dias, ROI mais alto do que qualquer campanha paga rodando junto. Estrutura completa de um fluxo testado em três e-commerces do portfólio.', category: 'E-mail marketing', publishedAt: '2026-04-28', readTime: 9, variant: 3 },
  { slug: { current: 'diagnostico-antes-de-proposta' }, title: 'Por que diagnóstico vem antes de proposta — sempre', excerpt: 'O cliente quer preço. A gente quer entender a operação primeiro. Não é teimosia metodológica: é o que faz a diferença entre proposta vendida e proposta entregue.', category: 'Estratégia & funil', publishedAt: '2026-04-21', readTime: 5, variant: 4 },
  { slug: { current: 'cordeiro-primeiro-milhao' }, title: 'Como a Cordeiro chegou ao primeiro milhão em 6 meses', excerpt: 'Não foi um único canal. Foram quatro coisas acontecendo ao mesmo tempo — e a ordem em que entraram em operação importou tanto quanto o que foi feito.', category: 'Cases & bastidores', publishedAt: '2026-04-14', readTime: 11, variant: 5 },
  { slug: { current: 'google-shopping-2026' }, title: 'Google Shopping para quem nunca testou: o que funciona em 2026', excerpt: 'O feed continua sendo a peça que define o teto da campanha. Estrutura mínima viável para começar bem — e os três erros que aparecem em quase toda conta nova.', category: 'Tráfego pago', publishedAt: '2026-04-08', readTime: 8, variant: 6 },
  { slug: { current: 'metricas-que-importam' }, title: 'Métricas que importam vs. relatório de vaidade', excerpt: 'CTR alto e engajamento bonito vendem reuniões, não produtos. As cinco métricas que ficam no nosso relatório semanal — e o que cortamos fora há tempos.', category: 'Diagnóstico & dados', publishedAt: '2026-04-02', readTime: 6, variant: 7 },
  { slug: { current: 'recuperacao-de-carrinho' }, title: 'Recuperação de carrinho: a sequência de 3 mensagens que basta', excerpt: 'Cinco, sete, dez mensagens — não é volume que recupera, é timing e ângulo. A estrutura mínima que vimos performar melhor que os fluxos longos.', category: 'Automação & IA', publishedAt: '2026-03-25', readTime: 7, variant: 8 },
];

const displayPosts = posts.length > 0 ? posts : staticPosts;
const featuredPost = displayPosts.find((p: any) => p.featured) || displayPosts[0];
const gridPosts = displayPosts.filter((p: any) => p !== featuredPost);

const categories = ['Todos', 'Tráfego pago', 'Automação & IA', 'E-mail', 'Estratégia', 'Cases'];

function formatDate(dateStr: string) {
  try {
    return new Date(dateStr).toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
  } catch { return dateStr; }
}

function getSlug(post: any) {
  return post.slug?.current || post.slug || '#';
}
---
<BaseLayout
  title="Blog — Ongrowing"
  description="Análises de operações reais de aquisição digital — diagnóstico, tráfego pago, automações e IA aplicados em e-commerce."
>
  <Fragment slot="head">
    <style is:global>
      .page-header {
        background: var(--og-deep-800);
        padding: var(--sp-12) var(--gutter) var(--sp-10);
        position: relative;
        overflow: hidden;
      }
      @media (min-width: 768px) { .page-header { padding: var(--sp-16) var(--gutter) var(--sp-12); } }
      @media (min-width: 1024px) { .page-header { padding: var(--sp-20) var(--gutter) var(--sp-16); } }
      .page-header::before { content: ''; position: absolute; top: -100px; right: -100px; width: 520px; height: 520px; background: radial-gradient(circle, rgba(121,217,199,.08) 0%, transparent 65%); pointer-events: none; }
      .page-header::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, var(--accent), transparent 55%); opacity: .7; }
      .page-header-mark { position: absolute; bottom: -60px; right: -40px; width: 360px; opacity: .04; filter: invert(1); pointer-events: none; }
      .breadcrumb { display: flex; align-items: center; gap: var(--sp-2); font-family: var(--font-display); font-size: 10px; text-transform: uppercase; letter-spacing: 2.5px; font-weight: 700; color: rgba(255,255,255,.35); margin-bottom: var(--sp-6); }
      .breadcrumb a { color: rgba(255,255,255,.35); text-decoration: none; transition: color var(--dur-fast) var(--ease-out); }
      .breadcrumb a:hover { color: rgba(255,255,255,.7); }
      .breadcrumb .sep { opacity: .4; }
      .breadcrumb .current { color: var(--accent); opacity: .85; }
      .page-header h1 { font-family: var(--font-display); font-size: clamp(28px, 5.2vw, 48px); font-weight: 800; color: #fff; letter-spacing: -1.2px; line-height: 1.08; margin-bottom: var(--sp-4); text-wrap: balance; }
      .page-header h1 em { font-style: italic; color: var(--accent); font-weight: 800; }
      .page-header p { font-family: var(--font-text); font-size: 17px; color: rgba(255,255,255,.55); font-weight: 300; max-width: 560px; line-height: 1.65; }

      .hero-post-wrap { padding: var(--sp-10) var(--gutter) var(--sp-8); background: var(--bg); }
      @media (min-width: 768px) { .hero-post-wrap { padding: var(--sp-12) var(--gutter) var(--sp-10); } }
      @media (min-width: 1024px) { .hero-post-wrap { padding: var(--sp-16) var(--gutter) var(--sp-10); } }
      .hero-post { display: grid; grid-template-columns: 1fr; gap: 0; align-items: stretch; text-decoration: none; color: inherit; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--r-xl); overflow: hidden; transition: box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out); }
      @media (min-width: 1024px) { .hero-post { grid-template-columns: 1.2fr 1fr; } }
      .hero-post:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
      .hero-post-img { background: var(--og-deep-800); position: relative; min-height: 220px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
      @media (min-width: 768px) { .hero-post-img { min-height: 280px; } }
      @media (min-width: 1024px) { .hero-post-img { min-height: 380px; } }
      .hero-post-img::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 70% 40%, rgba(121,217,199,.12) 0%, transparent 60%), radial-gradient(circle at 20% 80%, rgba(121,217,199,.06) 0%, transparent 55%); pointer-events: none; }
      .hero-post-img .glyph { width: 200px; height: 200px; opacity: .14; color: var(--accent); }
      .hero-post-img .glyph svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linejoin: round; stroke-linecap: round; }
      .hero-post-img .badge { position: absolute; top: var(--sp-6); left: var(--sp-6); display: inline-flex; align-items: center; gap: var(--sp-2); background: rgba(121,217,199,.12); border: 1px solid rgba(121,217,199,.28); color: var(--accent); font-family: var(--font-display); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 2.5px; padding: 6px 12px; border-radius: var(--r-pill); backdrop-filter: blur(8px); }
      .hero-post-content { padding: var(--sp-8); display: flex; flex-direction: column; justify-content: center; }
      @media (min-width: 768px) { .hero-post-content { padding: var(--sp-10); } }
      @media (min-width: 1024px) { .hero-post-content { padding: var(--sp-12) var(--sp-10); } }
      .post-category { font-family: var(--font-display); font-size: 10px; text-transform: uppercase; letter-spacing: 2.5px; font-weight: 700; color: var(--accent-strong); margin-bottom: var(--sp-4); display: inline-flex; align-items: center; gap: var(--sp-3); }
      .post-category::before { content: ''; display: inline-block; width: 22px; height: 1px; background: var(--accent-strong); opacity: .7; }
      .hero-post-content h2 { font-family: var(--font-display); font-size: clamp(22px, 3.4vw, 34px); font-weight: 700; color: var(--fg); line-height: 1.18; letter-spacing: -.6px; margin-bottom: var(--sp-4); text-wrap: balance; }
      .hero-post-content p { font-family: var(--font-text); font-size: 15px; color: var(--fg-muted); line-height: 1.7; margin-bottom: var(--sp-6); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      @media (min-width: 1024px) { .hero-post-content p { font-size: 16px; -webkit-line-clamp: 4; } }
      .post-meta { display: flex; align-items: center; gap: var(--sp-4); font-family: var(--font-display); font-size: 12px; color: var(--fg-subtle); font-weight: 500; letter-spacing: .2px; }
      .post-meta .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--fg-subtle); opacity: .5; }
      .post-meta .item { display: inline-flex; align-items: center; gap: 6px; }

      .blog-body { display: grid; grid-template-columns: 1fr; gap: var(--sp-10); padding: 0 var(--gutter) var(--sp-16); background: var(--bg); }
      @media (min-width: 1100px) { .blog-body { grid-template-columns: 1fr 300px; gap: var(--sp-16); padding-bottom: var(--sp-20); } }

      .filter-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--sp-4); margin-bottom: var(--sp-8); padding-bottom: var(--sp-5); border-bottom: 1px solid var(--border); }
      .section-label { font-family: var(--font-display); font-size: 11px; text-transform: uppercase; letter-spacing: 2.5px; font-weight: 700; color: var(--fg-subtle); display: inline-flex; align-items: center; gap: var(--sp-3); }
      .section-label::before { content: ''; display: inline-block; width: 18px; height: 1px; background: var(--fg-subtle); opacity: .5; }
      .filter-pills { display: flex; gap: var(--sp-2); flex-wrap: wrap; }
      .pill { padding: 6px 14px; border-radius: var(--r-pill); font-family: var(--font-display); font-size: 11px; font-weight: 600; cursor: pointer; transition: all var(--dur-fast) var(--ease-out); text-transform: uppercase; letter-spacing: 1.2px; border: 1px solid var(--border); color: var(--fg-muted); background: transparent; }
      .pill:hover { border-color: var(--accent-strong); color: var(--fg); }
      .pill.active { background: var(--og-deep-800); color: #fff; border-color: var(--og-deep-800); }

      .post-grid { display: grid; grid-template-columns: 1fr; gap: var(--sp-8) var(--sp-6); }
      @media (min-width: 640px) { .post-grid { grid-template-columns: 1fr 1fr; } }
      .post-card { text-decoration: none; color: inherit; display: flex; flex-direction: column; transition: transform var(--dur-base) var(--ease-out); }
      .post-card:hover { transform: translateY(-2px); }
      .post-card-img { height: 200px; border-radius: var(--r-lg); background: var(--og-deep-800); overflow: hidden; position: relative; margin-bottom: var(--sp-5); display: flex; align-items: center; justify-content: center; transition: box-shadow var(--dur-base) var(--ease-out); }
      .post-card:hover .post-card-img { box-shadow: var(--shadow-md); }
      .post-card-img::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 70% 50%, rgba(121,217,199,.1) 0%, transparent 60%); }
      .post-card-img .glyph { width: 100px; height: 100px; opacity: .14; color: var(--accent); }
      .post-card-img .glyph svg { width: 100%; height: 100%; fill: none; stroke: currentColor; stroke-width: 1.25; stroke-linejoin: round; stroke-linecap: round; }

      .img-v1 { background: var(--og-deep-800); }
      .img-v2 { background: var(--og-deep-700); }
      .img-v3 { background: var(--og-deep-900); }
      .img-v4 { background: var(--og-deep-600); }
      .img-v5 { background: var(--og-deep-800); background-image: linear-gradient(135deg, var(--og-deep-800) 0%, var(--og-deep-600) 100%); }
      .img-v6 { background: var(--og-deep-900); background-image: linear-gradient(135deg, var(--og-deep-900) 0%, var(--og-deep-700) 100%); }
      .img-v7 { background: var(--og-deep-700); }
      .img-v8 { background: var(--og-deep-800); }
      .img-v1 .glyph { transform: translateX(20%) scale(1.3); }
      .img-v2 .glyph { transform: translateX(-22%) scale(1.4); }
      .img-v3 .glyph { transform: scale(1.2); }
      .img-v4 .glyph { transform: translateX(24%) translateY(8%) scale(1.3); opacity: .1; }
      .img-v5 .glyph { transform: translateX(-18%) scale(1.5); }
      .img-v6 .glyph { transform: translateY(-5%) scale(1.3); }
      .img-v7 .glyph { transform: translateX(28%) scale(1.4); }
      .img-v8 .glyph { transform: translateX(-15%) translateY(5%) scale(1.4); }

      .post-card-tag { position: absolute; top: var(--sp-4); left: var(--sp-4); font-family: var(--font-display); font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: var(--accent); background: rgba(121,217,199,.1); border: 1px solid rgba(121,217,199,.22); padding: 4px 10px; border-radius: var(--r-pill); backdrop-filter: blur(8px); }
      .post-card h3 { font-family: var(--font-display); font-size: 19px; font-weight: 700; color: var(--fg); line-height: 1.25; letter-spacing: -.3px; margin-bottom: var(--sp-2); text-wrap: balance; transition: color var(--dur-fast) var(--ease-out); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; }
      .post-card:hover h3 { color: var(--accent-strong); }
      .post-card p { font-family: var(--font-text); font-size: 14.5px; color: var(--fg-muted); line-height: 1.6; margin-bottom: var(--sp-4); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: calc(1.6em * 3); }
      .post-card .post-meta { font-size: 11px; }
      .post-card .post-meta .dot { width: 2px; height: 2px; }

      .sidebar { display: flex; flex-direction: column; gap: var(--sp-5); }
      @media (min-width: 1100px) { .sidebar { position: sticky; top: var(--sp-6); align-self: start; } }
      @media (min-width: 640px) and (max-width: 1099px) { .sidebar { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); } .sidebar > :nth-child(3) { grid-column: 1 / -1; } }
      .sidebar-block { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--r-lg); padding: var(--sp-6); }
      .sidebar-title { font-family: var(--font-display); font-size: 11px; text-transform: uppercase; letter-spacing: 2.5px; font-weight: 700; color: var(--fg-subtle); margin-bottom: var(--sp-5); display: inline-flex; align-items: center; gap: var(--sp-3); }
      .sidebar-title::before { content: ''; display: inline-block; width: 16px; height: 1px; background: var(--accent); opacity: .8; }
      .cat-list { list-style: none; display: flex; flex-direction: column; }
      .cat-list li { border-bottom: 1px solid var(--border); }
      .cat-list li:last-child { border-bottom: none; }
      .cat-list a { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); padding: var(--sp-3) 0; font-family: var(--font-display); font-size: 13px; font-weight: 600; color: var(--fg); text-decoration: none; transition: color var(--dur-fast) var(--ease-out); }
      .cat-list a:hover { color: var(--accent-strong); }
      .cat-list a:hover .cat-count { background: var(--accent); color: var(--og-deep-800); }
      .cat-name { display: inline-flex; align-items: center; gap: var(--sp-3); }
      .cat-count { font-family: var(--font-display); font-size: 11px; font-weight: 700; color: var(--fg-subtle); background: var(--og-mist-100); padding: 2px 9px; border-radius: var(--r-pill); transition: all var(--dur-fast) var(--ease-out); }
      .recent-post { display: flex; flex-direction: column; gap: var(--sp-1); padding: var(--sp-4) 0; border-bottom: 1px solid var(--border); text-decoration: none; color: inherit; }
      .recent-post:last-child { border-bottom: none; padding-bottom: 0; }
      .recent-post:first-child { padding-top: 0; }
      .recent-post .meta { font-family: var(--font-display); font-size: 10px; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700; color: var(--accent-strong); }
      .recent-post .title { font-family: var(--font-display); font-size: 13.5px; font-weight: 600; color: var(--fg); line-height: 1.4; letter-spacing: -.1px; transition: color var(--dur-fast) var(--ease-out); }
      .recent-post:hover .title { color: var(--accent-strong); }
      .sidebar-cta { background: var(--og-deep-800); color: #fff; border: none; }
      .sidebar-cta h4 { font-family: var(--font-display); font-size: 16px; font-weight: 700; color: #fff; margin-bottom: var(--sp-2); line-height: 1.25; letter-spacing: -.2px; }
      .sidebar-cta h4 em { font-style: italic; color: var(--accent); }
      .sidebar-cta p { font-family: var(--font-text); font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.55; margin-bottom: var(--sp-5); }
      .sidebar-cta .btn { width: 100%; padding: 12px 16px; font-size: 12px; }

      .pagination { margin-top: var(--sp-12); padding-top: var(--sp-8); border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: center; gap: var(--sp-2); }
      .pag-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 36px; height: 36px; padding: 0 10px; border-radius: var(--r-sm); font-family: var(--font-display); font-size: 12px; font-weight: 700; color: var(--fg-muted); background: transparent; border: 1px solid var(--border); text-decoration: none; transition: all var(--dur-fast) var(--ease-out); cursor: pointer; }
      .pag-btn:hover { border-color: var(--og-deep-800); color: var(--fg); }
      .pag-btn.active { background: var(--og-deep-800); color: #fff; border-color: var(--og-deep-800); }
      .pag-btn.with-icon { gap: 6px; padding: 0 14px; }
    </style>
  </Fragment>

  <Topbar />

  <div class="page-header">
    <img src="/assets/mark-light.png" alt="" class="page-header-mark" aria-hidden="true">
    <div class="breadcrumb">
      <a href="/">Ongrowing</a>
      <span class="sep">/</span>
      <span class="current">Blog</span>
    </div>
    <h1>Análise de operações<br>de aquisição <em>reais.</em></h1>
    <p>Cases, decisões e aprendizados de quem está na operação — não de quem só faz conteúdo sobre operação.</p>
  </div>

  <!-- Featured post -->
  <div class="hero-post-wrap">
    <a href={`/blog/${getSlug(featuredPost)}/`} class="hero-post">
      <div class="hero-post-img">
        <div class="badge">Em destaque</div>
        <div class="glyph">
          <svg viewBox="0 0 24 24"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
        </div>
      </div>
      <div class="hero-post-content">
        <span class="post-category">{featuredPost.category}</span>
        <h2>{featuredPost.title}</h2>
        <p>{featuredPost.excerpt}</p>
        <div class="post-meta">
          <span class="item">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
            {formatDate(featuredPost.publishedAt)}
          </span>
          <span class="dot"></span>
          {featuredPost.readTime && <span class="item"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> {featuredPost.readTime} min de leitura</span>}
        </div>
      </div>
    </a>
  </div>

  <div class="blog-body">
    <div>
      <div class="filter-row">
        <span class="section-label">Posts recentes</span>
        <div class="filter-pills">
          {categories.map((cat) => (
            <button class={`pill${cat === 'Todos' ? ' active' : ''}`} data-filter={cat}>{cat}</button>
          ))}
        </div>
      </div>

      <div class="post-grid" id="post-grid">
        {gridPosts.map((post: any, i: number) => {
          const v = post.variant || ((i % 8) + 1);
          return (
            <a href={`/blog/${getSlug(post)}/`} class="post-card" data-category={post.category}>
              <div class={`post-card-img img-v${v}`}>
                <span class="post-card-tag">{post.category}</span>
                <div class="glyph">
                  <svg viewBox="0 0 24 24"><path d="m8 3 4 8 5-5 5 15H2L8 3z"/></svg>
                </div>
              </div>
              <span class="post-category">{post.category}</span>
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <div class="post-meta">
                <span class="item">{formatDate(post.publishedAt)}</span>
                {post.readTime && <><span class="dot"></span><span class="item">{post.readTime} min</span></>}
              </div>
            </a>
          );
        })}
      </div>

      <div class="pagination">
        <button class="pag-btn with-icon" disabled={page === 1} style={page === 1 ? 'opacity:.4;cursor:not-allowed;' : ''}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          Anterior
